# 사이트 기본 URL (sitemap, OG, canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 검색엔진 소유 확인 메타 태그 값(content 부분만). 비워 두면 태그를 내보내지 않는다. 서버 실행 환경에 설정한다(ISR 캐시된 페이지는 다음 갱신 때 반영)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# IndexNow 키(영문·숫자·하이픈 8~128자). 설정하면 /indexnow-key.txt로 공개하고, revalidate 웹훅이 바뀐 URL을 Bing·네이버 등에 알린다
INDEXNOW_KEY=

# Express API 주소 (/v1 없이, 예: https://api.example.com). 비워 두면 내장 목(mock) 데이터로 동작합니다.
API_BASE_URL=
# Next.js 서버 → Express 서비스 토큰 (백엔드 SERVICE_TOKENS 중 하나)
API_SERVICE_TOKEN=
# 커버 이미지 공개 주소 (백엔드 MEDIA_BASE_URL과 같은 값)
MEDIA_BASE_URL=

# Express가 발행·수정 후 호출하는 revalidate 웹훅 비밀값 (백엔드 WEB_REVALIDATE_SECRET과 같은 값)
REVALIDATE_SECRET=

# 관리자 인증 (GitHub OAuth → 단기 JWT). AUTH_SECRET은 백엔드 ADMIN_JWT_SECRET과 같은 값
AUTH_SECRET=change-me-to-a-long-random-string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 쉼표로 구분한 허용 GitHub 로그인
ADMIN_GITHUB_LOGINS=
# 개발 전용: 1이면 로그인 없이 관리자 화면 접근 (production에서는 무시)
ADMIN_DEV_BYPASS=1
