# 사이트 기본 URL (sitemap, OG, canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Express API (/v1). 비워 두면 내장 목(mock) 데이터로 동작합니다.
API_BASE_URL=
# Next.js 서버 → Express 서비스 토큰
API_SERVICE_TOKEN=

# Express가 발행·수정 후 호출하는 revalidate 웹훅 비밀값
REVALIDATE_SECRET=

# 관리자 인증 (GitHub OAuth → 단기 JWT)
AUTH_SECRET=change-me-to-a-long-random-string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 쉼표로 구분한 허용 GitHub 로그인
ADMIN_GITHUB_LOGINS=
# 개발 전용: 1이면 로그인 없이 관리자 화면 접근 (production에서는 무시)
ADMIN_DEV_BYPASS=1
